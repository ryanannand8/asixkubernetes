# Plantilla. Copia a secrets.yaml (ignorado por git) y pon tus valores:
#   cp secrets.yaml.example secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: mysql-pass-secret
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "CAMBIAME_root"
  MYSQL_PASSWORD: "CAMBIAME_user"
  MYSQL_USER: "wpuser"
  MYSQL_DATABASE: "wordpress"
